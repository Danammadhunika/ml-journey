# Copy this file to `.env` and fill in your real values.
# NEVER commit the real `.env` file — it is already in .gitignore.

# --- LLM provider ---
# Get a key from https://console.anthropic.com/ (Account Settings -> API Keys)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
LLM_MODEL=claude-sonnet-4-5
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# --- App environment ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=sqlite:///./database/job_search.db

# --- Resume ---
MASTER_RESUME_PATH=resume/master_resume/master_resume.json

# --- GitHub (for the Project Importer) ---
# Both optional: GITHUB_USERNAME lets you skip typing --username every
# time; GITHUB_TOKEN is only needed if you hit GitHub's unauthenticated
# rate limit (60 requests/hour) -- a token raises that to 5000/hour.
# A token here only ever needs "public_repo" read access, never write.
GITHUB_USERNAME=
GITHUB_TOKEN=

# --- Adzuna (for job discovery / search-jobs) ---
# Free API -- register at https://developer.adzuna.com/ to get an app_id
# and app_key. We use Adzuna instead of scraping Indeed/Dice/Glassdoor/
# JobRight directly because it's an official public API meant for this
# exact purpose -- scraping the others would violate their Terms of
# Service, which this project never does.
ADZUNA_APP_ID=11230b8c
ADZUNA_APP_KEY=3BYZnNcb_RKPKvFJXDFsOI3amGvBxWMrOTAcKA64leX5KbUSqyb8N61tAimIak6KLzlFJBsOy6jjiOSnPgQ5yQ-bPsfKQAA
ADZUNA_COUNTRY=us

# --- Future integrations (v2+) — leave blank until you get there ---
# GMAIL_CREDENTIALS_PATH=
# GOOGLE_CALENDAR_CREDENTIALS_PATH=
